# 构建产物
build/
out/
.tools/
*.o
*.a
*.so

# 仿真波形与大文件
*.vcd
*.fst
*.fsdb
*.vpd
*.saif

# 日志与临时文件
*.log
*.tmp
*.swp
.DS_Store

# 例外：阶段证据（日志与波形）需随仓库提交
# 阶段一 VCD 原始波形约 100 MB，不入库；仓库只保留截图（png）与解析日志
!docs/phase1/logs/*.log
!docs/phase1/wave/*.png
!docs/phase2/logs/*.log
!docs/phase2/waveform/*.vcd
!docs/phase3/*.log
!docs/phase4/*.log

# Python
__pycache__/
*.pyc
.venv/

# 工具链与本地环境
.venv*/
env.sh.local
.gtkwave-pkg/
.screenshots/

# 外部参考代码（仅本地参考，不纳入版本控制）
openTPU-main/

# 提交打包材料（本地生成，含视频/截图/文档副本，不纳入版本控制）
submission_bundle/
